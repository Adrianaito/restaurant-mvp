generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Business {
  id          String       @id @default(cuid())
  name        String
  products    Product[]
  ingredients Ingredient[]
  orders      Order[]
  tables      Table[]
  productions Production[]
}

model Table {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
}

model Product {
  id                   String       @id @default(cuid())
  name                 String
  businessId           String
  price                Float        @default(0)
  portionsPerUnit      Int          @default(1)
  lowPortionsThreshold Int?
  business        Business     @relation(fields: [businessId], references: [id])
  recipeItems     RecipeItem[]
  orderItems      OrderItem[]
  productions     Production[]
}

model Ingredient {
  id                String       @id @default(cuid())
  name              String
  stock             Float
  unit              String
  lowStockThreshold Float?
  businessId        String
  business          Business     @relation(fields: [businessId], references: [id])
  recipeItems       RecipeItem[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  amount       Float
  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
}

model Order {
  id         String         @id @default(cuid())
  businessId String
  label      String
  status     String         @default("draft")
  createdAt  DateTime       @default(now())
  paidAt     DateTime?
  business   Business       @relation(fields: [businessId], references: [id])
  items      OrderItem[]
  editLogs   OrderEditLog[]
}

model OrderEditLog {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  action         String
  productId      String
  productName    String
  quantityBefore Int?
  quantityAfter  Int?
  createdAt      DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Production {
  id           String   @id @default(cuid())
  productId    String
  portionsMade Int
  soldCount    Int      @default(0)
  createdAt    DateTime @default(now())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
}
